{
  "contract": "rune.project.v1",
  "project": "RUNE",
  "expanded_name": "Runtime for Unified Numeric Execution",
  "phase": {
    "id": "R0",
    "name": "Constitutional foundation",
    "runtime_implementation_allowed": false
  },
  "license": "MPL-2.0",
  "reference_language": {
    "standard": "ISO C99",
    "normative": true
  },
  "architecture": {
    "cpu_only": true,
    "gpu_runtime": false,
    "integer_only_public_execution_semantics": true,
    "deterministic_reference_first": true,
    "memory_model": "explicit-bounded",
    "primary_integration_target": "RIVET",
    "platform_specific_facilities_require_explicit_boundary": true,
    "os_specific_api_may_be_core_requirement": false
  },
  "authority": {
    "separation_required": true,
    "human_prose": [
      "README.md",
      "CONSTITUTION.md",
      "ROADMAP.md",
      "DONORS-v1.md"
    ],
    "machine_readable": [
      "machine/project-v1.json",
      "machine/invariants-v1.json",
      "machine/donors-v1.json"
    ],
    "agent_entrypoint": "AGENTS.md",
    "contradiction_policy": "fail-closed-and-report",
    "constitutional_change_policy": {
      "versioned_constitution_or_explicit_amendment_required": true,
      "corresponding_machine_contract_changes_required": true,
      "migration_statement_required": true,
      "evidence_of_preserved_or_intentionally_superseded_frozen_semantics_required": true,
      "implementation_convenience_is_sufficient_reason": false
    }
  },
  "core_equations": [
    "RESULT_IDENTITY != EXECUTION_PLAN_IDENTITY",
    "BENCHMARK_OBSERVATION != CORRECTNESS_IDENTITY",
    "LOGICAL_SCALE != RESIDENT_SCALE",
    "MORE_COMPUTE != BETTER_EXECUTION",
    "PLAN != EXECUTION_EVIDENCE"
  ],
  "runtime_nonrequirements": [
    "C++",
    "floating-point",
    "GPU",
    "managed-runtime",
    "garbage-collector",
    "JIT",
    "mandatory-threads",
    "mandatory-SIMD",
    "generic-scheduler",
    "plugin-system"
  ],
  "portability": {
    "host_pointer_width_is_portable_identity": false,
    "host_size_t_is_portable_semantic_identity": false,
    "portable_identity_representation": {
      "explicit_versioned_representation_required": true,
      "explicit_fixed_width_integer_representation_allowed": true,
      "other_explicit_versioned_representation_allowed": true,
      "native_host_type_alone_is_sufficient": false
    },
    "cross_compile_is_execution_evidence": false,
    "emulation_is_physical_hardware_evidence": false
  },
  "numeric_policy": {
    "public_semantics_require_floating_point": false,
    "fractional_semantics_require_explicit_versioned_integer_representation": true,
    "fractional_rounding_behavior_must_be_declared": true
  },
  "movement_policy": {
    "managed_storage_requires_explicit_ownership": true,
    "managed_storage_requires_explicit_lifetime": true,
    "meaningful_movement_identity_when_representable_requires": [
      "source",
      "destination",
      "extent"
    ]
  },
  "optimization_policy": {
    "ordered_pre_acceleration_steps": [
      "choose_representation",
      "choose_algorithm",
      "bound_resident_state",
      "remove_unnecessary_materialisation_and_movement",
      "remove_duplicate_work",
      "improve_locality",
      "measure"
    ],
    "acceleration_may_precede_required_steps": false,
    "acceleration_examples": [
      "SIMD",
      "threading",
      "topology_tuning",
      "specialized_CPU_paths"
    ]
  },
  "resource_failure_policy": {
    "explicit_failure_required_for": [
      "bounds_failure",
      "overflow",
      "impossible_alignment",
      "exhausted_scratch",
      "insufficient_destination_capacity",
      "unsupported_capability"
    ],
    "silent_budget_exceed_allowed": false,
    "silent_invalid_extent_wrap_allowed": false,
    "silent_truncation_allowed_unless_declared_operation": false
  },
  "semantic_scope": {
    "excluded_from_rune_semantics": [
      "browser",
      "HTML",
      "CSS",
      "document",
      "GUI",
      "window",
      "image_format",
      "application",
      "business"
    ],
    "general_primitives_may_support_excluded_domains_without_absorbing_their_meaning": true
  },
  "evidence": {
    "donor_benchmarks_transferable": false,
    "requested_or_planned_work_is_execution_evidence": false,
    "execution_evidence_must_state_what_executed": true,
    "execution_evidence_class_required": true,
    "performance_claims_environment_scoped": true,
    "performance_observation_required_dimensions": [
      "source_revision",
      "workload",
      "compiler_toolchain",
      "build_configuration",
      "cpu_platform",
      "memory_profile",
      "measurement_method"
    ],
    "performance_cost_scope": {
      "complete_applicable_lifecycle_costs_required": true,
      "memory_costs_required": true,
      "kernel_only_measurement_is_sufficient_for_promotion": false,
      "lifecycle_examples": [
        "allocation",
        "setup",
        "execution",
        "teardown"
      ]
    },
    "correctness_precedes_performance": true
  },
  "machine_contracts": {
    "invariants": "machine/invariants-v1.json",
    "donors": "machine/donors-v1.json"
  }
}
