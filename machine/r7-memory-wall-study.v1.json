      "GIT_INDEX_FILE",
      "GIT_OBJECT_DIRECTORY",
      "GIT_ALTERNATE_OBJECT_DIRECTORIES",
      "GIT_COMMON_DIR",
      "GIT_NAMESPACE"
    ],
    "git_provenance_commands_anchored_with_git_C_repo_root": true,
    "repository_root_dirname_resolved_from_fixed_provenance_PATH": true,
    "git_provenance_PATH_fixed": "/usr/bin:/bin:/usr/sbin:/sbin",
    "git_executable_resolved_from_fixed_provenance_PATH": true,
    "git_executable_identity_recorded": true,
    "RUNE_R7_BUILD_PATH_may_control_git_provenance": false,
    "git_routing_sanitation_self_test": "scripts/r7-run-local.sh --self-test-git-root",
    "git_no_replace_objects_required": true,
    "git_replacement_refs_allowed": false,
    "raw_worktree_identity_paths": [
