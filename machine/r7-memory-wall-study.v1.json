{
  "contract": "rune.r7-memory-wall-study.v1",
  "phase": "R7",
  "reference_language": "ISO C99",
  "role": "local-first-performance-observation-harness",
  "runtime_core_changes_allowed": false,
  "raw_observation_capture_allowed": true,
  "runtime_performance_claims_allowed": false,
  "completion_requires_committed_reviewed_local_evidence": true,
  "timer": {
    "api": "clock",
    "standard": "ISO C99",
    "semantic": "process CPU time",
    "unit": "clock ticks",
    "scale_field": "clock_ticks_per_second",
    "wall_clock_claim": false,
    "unavailable_is_explicit_failure": true,
    "integral_clock_t_required": true,
    "floating_clock_t_rejected_before_integer_conversion": true
  },
  "lifecycle": {
    "fields": [
      "setup_ticks",
      "execute_ticks",
      "teardown_ticks",
      "total_ticks"
    ],
    "complete_lifecycle_required": true,
    "kernel_only_sufficient_for_promotion": false
  },
  "observation": {
    "contract": "rune.r7.memory-wall-observation.v1",
    "encoding": "numeric ASCII TSV",
    "columns": [
      "comparison_id",
      "variant_id",
      "working_set_bytes",
      "repeat_index",
      "logical_items",
      "resident_bytes",
      "peak_live_bytes",
      "cumulative_traffic_bytes",
      "model_bytes_read",
      "model_bytes_written",
      "result_u64",
      "setup_ticks",
      "execute_ticks",
      "teardown_ticks",
      "total_ticks",
      "clock_ticks_per_second",
      "lifecycle_complete"
    ],
    "timing_part_of_correctness_identity": false,
    "model_byte_fields_are_hardware_counter_evidence": false
  },
  "comparisons": {
    "1": {
      "name": "locality",
      "variants": {
        "1": "sequential",
        "2": "odd-stride-full-cycle"
      },
      "exact_result_parity_required": true
    },
    "2": {
      "name": "materialized-vs-fused",
      "variants": {
        "1": "materialized",
        "2": "fused"
      },
      "exact_result_parity_required": true
    },
    "3": {
      "name": "aos-vs-soa",
      "variants": {
        "1": "six-u32-lane-AoS",
        "2": "three-hot-field-SoA"
      },
      "logical_aos_record_bytes": 24,
      "host_struct_padding_used": false,
      "exact_result_parity_required": true
    },
    "4": {
      "name": "microtile-sweep",
      "variant_id_is_tile_elements": true,
      "tile_sizes": [
        32,
        64,
        128,
        256,
        512,
        1024,
        2048,
        4096
      ],
      "exact_result_parity_required": true,
      "tile_storage_allocation": "selected-tile-only",
      "tile_allocation_included_in_setup_ticks": true,
      "tile_release_included_in_teardown_ticks": true,
      "resident_and_peak_bytes_equal_selected_tile_extent": true,
      "all_declared_tile_sizes_execute_for_every_valid_working_set": true,
      "tile_larger_than_logical_input_allocates_selected_extent_and_processes_available_items": true
    },
    "5": {
      "name": "retain-vs-regenerate",
      "variants": {
        "1": "retain",
        "2": "regenerate"
      },
      "exact_result_parity_required": true
    },
    "6": {
      "name": "lookup-vs-recompute",
      "variants": {
        "1": "4096-entry-lookup",
        "2": "integer-recompute"
      },
      "exact_result_parity_required": true
    },
    "7": {
      "name": "peak-live-vs-cumulative-traffic",
      "uses_R2_arena": true,
      "high_water_recorded": true,
      "cumulative_consumed_recorded": true
    },
    "8": {
      "name": "logical-domain-vs-resident",
      "logical_items": "1099511627776",
      "resident_bytes": 48,
      "full_materialization": false
    }
  },
  "profiles": {
    "smoke": {
      "working_set_bytes": 32768,
      "repeats": 1,
      "expected_rows": 20
    },
    "local": {
      "working_set_bytes": [
        4096,
        32768,
        262144,
        1048576,
        4194304,
        16777216,
        67108864
      ],
      "default_repeats": 5,
      "direct_profile_invocation_uses_default_repeats_when_not_explicit": true
    },
    "explicit": {
      "min_bytes": 4096,
      "max_bytes": 67108864,
      "power_of_two_required": true,
      "repeats_min": 1,
      "repeats_max": 100
    }
  },
  "evidence_bundle": {
    "script": "scripts/r7-run-local.sh",
    "required_files": [
      "environment.txt",
      "compiler.txt",
      "command.txt",
      "observations.tsv",
      "SHA256SUMS"
    ],
    "required_dimensions": [
      "source_revision",
      "workload",
      "compiler_toolchain",
      "build_configuration",
      "cpu_platform",
      "memory_profile",
      "measurement_method"
    ],
    "dirty_state_recorded": true,
    "integrity": "SHA-256",
    "integrity_utility_resolved_from_fixed_provenance_PATH": true,
    "integrity_utility_path_recorded": true,
    "integrity_utility_identity_recorded": true,
    "ambient_PATH_may_control_integrity_utility": false,
    "evidence_class": "raw-local-execution-observation",
    "evidence_class_required": true,
    "destination_must_not_preexist": true,
    "overwrite_existing_bundle_allowed": false,
    "bundle_files_staged_under_ignored_build_until_finalization": true,
    "bundle_stage_removed_on_capture_failure": true,
    "source_snapshot_removed_on_capture_failure": true,
    "requested_destination_created_only_by_final_publish": true,
    "publish_requires_successful_measurement": true,
    "publish_requires_final_source_revalidation": true,
    "publish_requires_SHA256SUMS": true,
    "publish_copies_to_sibling_stage_on_destination_filesystem": true,
    "publish_sibling_stage_SHA256_verified_before_final_rename": true,
    "publish_final_rename_is_same_parent_filesystem": true,
    "failed_publish_must_leave_requested_destination_absent": true,
    "publish_copy_tool_resolved_from_fixed_provenance_PATH": true,
    "default_in_repo_evidence_destination_supported": true,
    "repeats_validated_before_destination_creation": true,
    "bundle_directory_created_with_fixed_provenance_mkdir": true,
    "new_bundle_directory_must_be_empty_before_metadata_write": true,
    "dirty_state_includes_untracked_files": true,
    "dirty_state_sampled_before_bundle_creation": true,
    "CPPFLAGS_recorded_and_bound": true,
    "CFLAGS_recorded_and_bound": true,
    "CPPFLAGS_and_CFLAGS_make_variable_references_allowed": false,
    "CPPFLAGS_and_CFLAGS_dollar_signs_allowed": false,
    "CPPFLAGS_and_CFLAGS_recording_uses_printf_not_echo": true,
    "CPPFLAGS_and_CFLAGS_backslashes_preserved_exactly": true,
    "compiler_command_must_be_single_executable": true,
    "compiler_path_resolution_required": true,
    "compiler_resolved_from_fixed_provenance_PATH": true,
    "compiler_path_canonicalized_before_trusted_prefix_check": true,
    "external_compiler_wrappers_allowed": false,
    "compiler_version_capture_required": true,
    "compiler_identity_failure_is_capture_failure": true,
    "memory_profile_required": true,
    "memory_profile_sources": [
      "/proc/meminfo",
      "sysctl hw.memsize/hw.physmem64/hw.physmem",
      "getconf _PHYS_PAGES + PAGE_SIZE"
    ],
    "missing_memory_profile_is_capture_failure": true,
    "inherited_make_control_variables_sanitized": [
      "MAKEFLAGS",
      "GNUMAKEFLAGS",
      "MFLAGS",
      "MAKEFILES",
      "MAKEOVERRIDES"
    ],
    "inherited_make_dry_run_must_not_affect_build": true,
