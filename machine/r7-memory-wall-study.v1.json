{
  "contract": "rune.r7-memory-wall-study.v1",
  "phase": "R7",
  "reference_language": "ISO C99",
  "role": "local-first-performance-observation-harness",
  "runtime_core_changes_allowed": false,
  "raw_observation_capture_allowed": true,
  "runtime_performance_claims_allowed": false,
  "completion_requires_committed_reviewed_local_evidence": true,
  "timer": {
    "api": "clock",
    "standard": "ISO C99",
    "semantic": "process CPU time",
    "unit": "clock ticks",
    "scale_field": "clock_ticks_per_second",
    "wall_clock_claim": false,
    "unavailable_is_explicit_failure": true
  },
  "lifecycle": {
    "fields": [
      "setup_ticks",
      "execute_ticks",
      "teardown_ticks",
      "total_ticks"
    ],
    "complete_lifecycle_required": true,
    "kernel_only_sufficient_for_promotion": false
  },
  "observation": {
    "contract": "rune.r7.memory-wall-observation.v1",
    "encoding": "numeric ASCII TSV",
    "columns": [
      "comparison_id",
      "variant_id",
      "working_set_bytes",
      "repeat_index",
      "logical_items",
      "resident_bytes",
      "peak_live_bytes",
      "cumulative_traffic_bytes",
      "model_bytes_read",
      "model_bytes_written",
      "result_u64",
      "setup_ticks",
      "execute_ticks",
      "teardown_ticks",
      "total_ticks",
      "clock_ticks_per_second",
      "lifecycle_complete"
    ],
    "timing_part_of_correctness_identity": false,
    "model_byte_fields_are_hardware_counter_evidence": false
  },
  "comparisons": {
    "1": {
      "name": "locality",
      "variants": {
        "1": "sequential",
        "2": "odd-stride-full-cycle"
      },
      "exact_result_parity_required": true
    },
    "2": {
      "name": "materialized-vs-fused",
      "variants": {
        "1": "materialized",
        "2": "fused"
      },
      "exact_result_parity_required": true
    },
    "3": {
      "name": "aos-vs-soa",
      "variants": {
        "1": "six-u32-lane-AoS",
        "2": "three-hot-field-SoA"
      },
      "logical_aos_record_bytes": 24,
      "host_struct_padding_used": false,
      "exact_result_parity_required": true
    },
    "4": {
      "name": "microtile-sweep",
      "variant_id_is_tile_elements": true,
      "tile_sizes": [
        32,
        64,
        128,
        256,
        512,
        1024,
        2048,
        4096
      ],
      "exact_result_parity_required": true,
      "tile_storage_allocation": "selected-tile-only",
      "tile_allocation_included_in_setup_ticks": true,
      "tile_release_included_in_teardown_ticks": true,
      "resident_and_peak_bytes_equal_selected_tile_extent": true
    },
    "5": {
      "name": "retain-vs-regenerate",
      "variants": {
        "1": "retain",
        "2": "regenerate"
      },
      "exact_result_parity_required": true
    },
    "6": {
      "name": "lookup-vs-recompute",
      "variants": {
        "1": "4096-entry-lookup",
        "2": "integer-recompute"
      },
      "exact_result_parity_required": true
    },
    "7": {
      "name": "peak-live-vs-cumulative-traffic",
      "uses_R2_arena": true,
      "high_water_recorded": true,
      "cumulative_consumed_recorded": true
    },
    "8": {
      "name": "logical-domain-vs-resident",
      "logical_items": "1099511627776",
      "resident_bytes": 48,
      "full_materialization": false
    }
  },
  "profiles": {
    "smoke": {
      "working_set_bytes": 32768,
      "repeats": 1,
      "expected_rows": 20
    },
    "local": {
      "working_set_bytes": [
        4096,
        32768,
        262144,
        1048576,
        4194304,
        16777216,
        67108864
      ],
      "default_repeats": 5,
      "direct_profile_invocation_uses_default_repeats_when_not_explicit": true
    },
    "explicit": {
      "min_bytes": 4096,
      "max_bytes": 67108864,
      "power_of_two_required": true,
      "repeats_min": 1,
      "repeats_max": 100
    }
  },
  "evidence_bundle": {
    "script": "scripts/r7-run-local.sh",
    "required_files": [
      "environment.txt",
      "compiler.txt",
      "command.txt",
      "observations.tsv",
      "SHA256SUMS"
    ],
    "required_dimensions": [
      "source_revision",
      "workload",
      "compiler_toolchain",
      "build_configuration",
      "cpu_platform",
      "memory_profile",
      "measurement_method"
    ],
    "dirty_state_recorded": true,
    "integrity": "SHA-256",
    "evidence_class": "raw-local-execution-observation",
    "evidence_class_required": true,
    "destination_must_not_preexist": true,
    "overwrite_existing_bundle_allowed": false,
    "dirty_state_includes_untracked_files": true,
    "dirty_state_sampled_before_bundle_creation": true,
    "CPPFLAGS_recorded_and_bound": true,
    "CFLAGS_recorded_and_bound": true,
    "compiler_command_must_be_single_executable": true,
    "compiler_path_resolution_required": true,
    "compiler_version_capture_required": true,
    "compiler_identity_failure_is_capture_failure": true,
    "memory_profile_required": true,
    "memory_profile_sources": [
      "/proc/meminfo",
      "sysctl hw.memsize/hw.physmem64/hw.physmem",
      "getconf _PHYS_PAGES + PAGE_SIZE"
    ],
    "missing_memory_profile_is_capture_failure": true,
    "inherited_make_control_variables_sanitized": [
      "MAKEFLAGS",
      "GNUMAKEFLAGS",
      "MFLAGS",
      "MAKEFILES",
      "MAKEOVERRIDES"
    ],
    "inherited_make_dry_run_must_not_affect_build": true,
    "build_target_must_be_rebuilt_from_recorded_source_configuration": true,
    "destination_under_build_directory_allowed": false,
    "destination_path_checked_against_physical_parent": true,
    "getconf_memory_profile_requires_both_nonzero_numeric_phys_pages_and_page_size": true,
    "AR_recorded_and_bound": true,
    "archiver_command_must_be_single_executable": true,
    "archiver_path_resolution_required": true,
    "archiver_version_capture_required": true,
    "archiver_identity_failure_is_capture_failure": true,
    "command_recording": "POSIX-shell-replayable-single-quoted",
    "multiword_CPPFLAGS_and_CFLAGS_are_unambiguously_serialized": true,
    "command_recording_self_test": "scripts/r7-run-local.sh --self-test-shell-quote",
    "shell_safe_quoting_handles_spaces_and_single_quotes": true,
    "toolchain_identity_includes": [
      "compiler",
      "archiver"
    ],
    "clean_working_tree_required": true,
    "dirty_working_tree_capture_allowed": false,
    "source_revision_must_identify_exact_built_contents": true,
    "platform_identity_required": true,
    "platform_identity_command": "uname -a",
    "platform_identity_capture_must_succeed": true,
    "platform_identity_must_be_nonempty": true,
    "makefile_path": "$repo_root/Makefile",
    "makefile_must_be_tracked": true,
    "makefile_blob_identity_recorded": true,
    "makefile_selected_explicitly_with_make_f": true,
    "implicit_GNUmakefile_or_lowercase_makefile_discovery_allowed": false,
    "ignored_build_controlling_makefile_can_override_recipe": false,
    "assume_unchanged_index_flags_allowed": false,
    "skip_worktree_index_flags_allowed": false,
    "index_visibility_flags_checked_before_capture": true,
    "git_routing_environment_sanitized": [
      "GIT_DIR",
      "GIT_WORK_TREE",
      "GIT_INDEX_FILE",
      "GIT_OBJECT_DIRECTORY",
      "GIT_ALTERNATE_OBJECT_DIRECTORIES",
      "GIT_COMMON_DIR",
      "GIT_NAMESPACE"
    ],
    "git_provenance_commands_anchored_with_git_C_repo_root": true,
    "git_routing_sanitation_self_test": "scripts/r7-run-local.sh --self-test-git-root",
    "ignored_untracked_compiler_inputs_allowed": false,
    "ignored_compiler_input_trees": [
      "src",
      "include",
      "study"
    ],
    "compiler_search_environment_sanitized": [
      "CPATH",
      "C_INCLUDE_PATH",
      "CPLUS_INCLUDE_PATH",
      "OBJC_INCLUDE_PATH",
      "COMPILER_PATH",
      "LIBRARY_PATH",
      "GCC_EXEC_PREFIX"
    ],
    "ambient_compiler_search_paths_allowed": false,
    "compiler_search_sanitation_recorded_in_environment": true,
    "compiler_search_sanitation_recorded_in_command": true,
    "compiler_search_sanitation_self_test": "scripts/r7-run-local.sh --self-test-compiler-search-env",
    "dynamic_loader_environment_sanitized": [
      "LD_PRELOAD",
      "LD_LIBRARY_PATH",
      "LD_AUDIT",
      "DYLD_INSERT_LIBRARIES",
      "DYLD_LIBRARY_PATH",
      "DYLD_FRAMEWORK_PATH",
      "DYLD_FALLBACK_LIBRARY_PATH",
      "DYLD_FALLBACK_FRAMEWORK_PATH",
      "LIBPATH",
      "SHLIB_PATH"
    ],
    "dynamic_loader_injection_allowed": false,
    "dynamic_loader_sanitation_recorded_in_environment": true,
    "dynamic_loader_sanitation_recorded_in_command": true,
    "dynamic_loader_sanitation_self_test": "scripts/r7-run-local.sh --self-test-dynamic-loader-env",
    "replay_build_uses_make_C_repo_root": true,
    "replay_build_makefile_argument": "Makefile",
    "replay_study_executable_path_is_absolute": true,
    "replay_command_is_working_directory_independent": true
  },
  "interpretation": {
    "github_hosted_CI_timing_is_performance_evidence": false,
    "timing_alone_can_establish_cache_cause": false,
    "timing_alone_can_establish_NUMA_cause": false,
    "timing_alone_can_establish_memory_bandwidth_cause": false,
    "negative_results_must_be_retained": true,
    "universal_claims_allowed": false
  },
  "validation": {
    "source": "study/r7_memory_wall.c",
    "smoke_command": "make r7-study-smoke",
    "local_capture_command": "./scripts/r7-run-local.sh",
    "compilers": [
      "gcc",
      "clang"
    ],
    "CI_validates_harness_not_performance": true
  },
  "measurement_integrity": {
    "volatile_accesses_are_study_mechanics": true,
    "purpose": "prevent-optimizer-from-collapsing-declared-materialization-tile-retain-recompute-variants",
    "volatile_semantics_are_part_of_R7_harness_not_runtime_API": true,
    "clock_wrap_is_rejected_before_tick_subtraction": true
  }
}
