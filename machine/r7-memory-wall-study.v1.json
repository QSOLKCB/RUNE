  "validation": {
    "source": "study/r7_memory_wall.c",
    "smoke_command": "make r7-study-smoke",
    "local_capture_command": "./scripts/r7-run-local.sh",
    "compilers": [
      "gcc",
      "clang"
    ],
    "CI_validates_harness_not_performance": true,
    "CI_validates_4096_byte_profile_has_20_rows_and_all_eight_microtiles": true,
    "evidence_regression_script": "tests/test_r7_run_local.sh",
    "evidence_regression_command": "make r7-evidence-regression",
    "evidence_regression_default_CC_cc_supported": true,
