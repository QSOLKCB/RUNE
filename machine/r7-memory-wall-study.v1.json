      "mkdir",
      "chmod",
      "rm"
    ],
    "platform_identity_required": true,
    "platform_identity_command": "uname -a",
    "platform_identity_executable_resolved_from_fixed_provenance_PATH": true,
    "platform_identity_executable_path_recorded": true,
    "ambient_PATH_may_control_platform_identity": false,
    "platform_identity_capture_must_succeed": true,
    "platform_identity_must_be_nonempty": true,
    "platform_identity_serialization_uses_printf": true,
    "CPU_model_serialization_uses_printf": true,
    "environment_serialization_backslash_self_test": "scripts/r7-run-local.sh --self-test-environment-serialization",
    "shell_quote_serializer_tool": "sed",
    "shell_quote_serializer_resolved_from_fixed_provenance_PATH": true,
    "shell_quote_serializer_path_recorded": true,
    "memory_profile_parser_tool": "awk",
    "memory_profile_parser_resolved_from_fixed_provenance_PATH": true,
    "memory_profile_parser_path_recorded": true,
    "optional_host_probe_tools_resolved_from_fixed_provenance_PATH": [
      "getconf",
      "sysctl"
    ],
    "makefile_path": "$repo_root/Makefile",
    "makefile_must_be_tracked": true,
    "makefile_blob_identity_recorded": true,
    "makefile_selected_explicitly_with_make_f": true,
    "implicit_GNUmakefile_or_lowercase_makefile_discovery_allowed": false,
    "ignored_build_controlling_makefile_can_override_recipe": false,
    "assume_unchanged_index_flags_allowed": false,
    "skip_worktree_index_flags_allowed": false,
    "index_visibility_flags_checked_before_capture": true,
    "git_routing_environment_sanitized": [
      "GIT_DIR",
