    "clock_regression_source": "tests/test_r7_clock.c",
    "clock_regression_command": "make r7-clock-regression",
    "evidence_regressions_cover": [
      "canonical tool path traversal for CC/AR/Make",
      "fail-fast command.txt replay",
      "TAR_OPTIONS injection",
      "destination-filesystem ENOSPC publication cleanup",
      "concurrent captures with existing build parent",
      "concurrent captures with absent build parent",
      "platform identity backslash serialization",
      "Clang CCC_OVERRIDE_OPTIONS injection",
      "Make-variable expansion in CPPFLAGS/CFLAGS",
      "ambient dirname repository-root redirection",
      "default cc regression entrypoint",
      "shared-memory publication fixture cleanup",
      "competing captures targeting the same absent destination",
      "backtick command substitution in CFLAGS",
      "shell command separator injection in CFLAGS",
      "pathname glob expansion in CPPFLAGS",
      "compiler response-file expansion in CFLAGS/CPPFLAGS"
    ],
    "clock_regressions_run_under_UBSan": true,
