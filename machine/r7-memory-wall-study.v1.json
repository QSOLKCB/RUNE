    "destination_under_build_directory_allowed": false,
    "destination_path_checked_against_physical_parent": true,
    "destination_lexical_route_through_build_allowed": false,
    "destination_parent_traversal_allowed": false,
    "getconf_memory_profile_requires_both_nonzero_numeric_phys_pages_and_page_size": true,
    "AR_recorded_and_bound": true,
    "archiver_command_must_be_single_executable": true,
    "archiver_path_resolution_required": true,
    "archiver_resolved_from_fixed_provenance_PATH": true,
    "archiver_path_canonicalized_before_trusted_prefix_check": true,
    "external_archiver_wrappers_allowed": false,
    "archiver_version_capture_required": true,
    "archiver_identity_failure_is_capture_failure": true,
    "command_recording": "POSIX-shell-replayable-single-quoted",
    "multiword_CPPFLAGS_and_CFLAGS_are_unambiguously_serialized": true,
    "command_recording_self_test": "scripts/r7-run-local.sh --self-test-shell-quote",
    "shell_safe_quoting_handles_spaces_and_single_quotes": true,
    "toolchain_identity_includes": [
      "compiler",
      "archiver",
      "build_driver"
    ],
    "build_driver_path_resolution_required": true,
    "build_driver_path_canonicalized_before_trusted_prefix_check": true,
    "build_driver_identity_capture_required": true,
    "build_driver_identity_failure_is_capture_failure": true,
    "ambient_PATH_inherited_by_evidence_build": false,
    "evidence_build_PATH_fixed": "/usr/bin:/bin:/usr/sbin:/sbin",
    "evidence_build_PATH_caller_override_allowed": false,
    "make_compiler_archiver_mkdir_rm_resolved_from_fixed_provenance_PATH": true,
    "fresh_unique_BUILD_DIR_required": true,
    "fresh_BUILD_DIR_identity": "UTC timestamp + shell PID",
    "capture_identity": "UTC timestamp + shell PID",
    "capture_identity_shared_by_source_build_bundle_stage_and_publish_stage": true,
    "concurrent_evidence_builds_must_use_distinct_BUILD_DIRs": true,
    "shared_build_parent_creation_is_idempotent": true,
    "concurrent_capture_test_with_existing_build_parent": true,
    "concurrent_capture_test_with_absent_build_parent": true,
    "make_facing_BUILD_DIR_is_repository_relative": true,
    "make_facing_study_target_is_repository_relative": true,
    "shell_facing_study_executable_is_absolute": true,
    "repository_paths_with_spaces_supported": true,
    "make_clean_required_for_evidence_build": false,
    "fresh_build_self_test": "scripts/r7-run-local.sh --self-test-fresh-build",
    "fresh_build_concurrency_CI_tested": true,
    "repository_space_path_CI_tested": true,
    "clean_working_tree_required": true,
    "dirty_working_tree_capture_allowed": false,
    "source_revision_must_identify_exact_built_contents": true,
    "evidence_build_source_origin": "git archive of source_revision",
    "evidence_build_uses_mutable_worktree_source": false,
    "source_snapshot_paths": [
      "Makefile",
